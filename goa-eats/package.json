{
  "name": "goa-eats",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n CLIENT,SERVER \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "npm --prefix client run dev -- --host 0.0.0.0",
    "dev:server": "npm --prefix server run dev",
    "build": "npm --prefix client run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
